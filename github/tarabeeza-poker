void _soon(BuildContext context, String what) {
  ScaffoldMessenger.of(context).showSnackBar(
    SnackBar(content: Text('$what قريبًا'), duration: const Duration(seconds: 1)),
  );
}


void _openGame(BuildContext context, String name) {
  if (name == 'بوكر' || name == 'أوماها') {
    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (_) => PokerTablePage(
          title: name == 'بوكر' ? 'تكساس هولدم' : 'أوماها بوكر',
          omaha: name == 'أوماها',
        ),
      ),
    );
  } else {
    _soon(context, 'لعبة $name');
  }
}

