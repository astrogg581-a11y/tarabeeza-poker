class _GamesArea extends StatelessWidget {
  const _GamesArea({this.columns = 3});
  final int columns;

  static const games = [
    ['بوكر', 'poker', '1254', 0xFF17634E, 0xFF0E3B34],
    ['الدومينو', 'domino', '893', 0xFF1E7A3E, 0xFF0F4A2A],
    ['أوماها', 'omaha', '567', 0xFF1E7A3E, 0xFF0F4A2A],
    ['تين باتي', 'tin', '742', 0xFF1B6C7A, 0xFF0D3345],
    ['أقل أو أعلى من 7', 'dice', '621', 0xFF6C287E, 0xFF29133D],
    ['ألعاب ورق متنوعة', 'misc', '438', 0xFF1F4E9A, 0xFF11264F],
  ];

  @override
  Widget build(BuildContext context) {
    final rows = games.length ~/ columns;
    return Column(
      children: [
        const Padding(
          padding: EdgeInsets.only(bottom: 6),
          child: _Logo(),
        ),
        for (int r = 0; r < rows; r++) ...[
          Expanded(child: _row(context, r * columns)),
          if (r != rows - 1) const SizedBox(height: 8),
        ],
      ],
    );
  }

  Widget _row(BuildContext context, int start) {
    return Row(
      children: [
        for (int i = start; i < start + columns; i++) ...[
          Expanded(
            child: _GameCard(
              name: games[i][0] as String,
              kind: games[i][1] as String,
              players: games[i][2] as String,
              c1: Color(games[i][3] as int),
              c2: Color(games[i][4] as int),
              onTap: () => _openGame(context, games[i][0] as String),
            ),
          ),
          if (i != start + columns - 1) const SizedBox(width: 8),
        ],
      ],
    );
  }
}

